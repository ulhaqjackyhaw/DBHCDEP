@push('scripts')
    <script>
        // Data PGS for Alpine.js
        const dataPgsRows = {!! json_encode(
            $dataPgs->map(function ($pgs) {
                    return [
                        'id' => $pgs->id,
                        'nik' => $pgs->nik,
                        'nama' => $pgs->nama,
                        'jabatan_definitif' => $pgs->jabatan_definitif,
                        'jabatan_pgs' => $pgs->jabatan_pgs,
                        'lokasi_unit_kerja' => $pgs->lokasi_unit_kerja,
                        'tanggal_pgs_formatted' => $pgs->tanggal_pgs_formatted,
                        'durasi_pgs' => $pgs->durasi_pgs,
                        'edit_url' => route('data-pgs.edit', $pgs),
                        'delete_url' => route('data-pgs.destroy', $pgs),
                    ];
                })->toArray(),
        ) !!};

        function showDetail(pgsId) {
            $('#pgsDetailModal').modal('show');
            // Load detail via AJAX
            fetch(`/data-pgs/${pgsId}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('pgsDetailContent').innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('pgsDetailContent').innerHTML =
                        '<div class="text-center text-danger p-4">Gagal memuat data</div>';
                });
        }

        function tableSortData() {
            return {
                sortField: '',
                sortAsc: true,
                searchQuery: '',
                rows: dataPgsRows,
                sortBy(field) {
                    if (this.sortField === field) {
                        this.sortAsc = !this.sortAsc;
                    } else {
                        this.sortField = field;
                        this.sortAsc = true;
                    }
                },
                search() {
                    // Trigger reactivity
                },
                clearSearch() {
                    this.searchQuery = '';
                },
                filteredRows() {
                    if (!this.searchQuery) return this.rows;
                    const query = this.searchQuery.toLowerCase();
                    return this.rows.filter(row => {
                        return (
                            row.nik.toLowerCase().includes(query) ||
                            row.nama.toLowerCase().includes(query) ||
                            row.jabatan_definitif.toLowerCase().includes(query) ||
                            row.jabatan_pgs.toLowerCase().includes(query) ||
                            row.lokasi_unit_kerja.toLowerCase().includes(query)
                        );
                    });
                },
                sortedRows() {
                    let filtered = this.filteredRows();
                    if (!this.sortField) return filtered;
                    return [...filtered].sort((a, b) => {
                        let aVal = a[this.sortField] || '';
                        let bVal = b[this.sortField] || '';
                        // Try numeric sort
                        let aNum = parseFloat(aVal.toString().replace(/[^0-9.,-]/g, '').replace(',', '.'));
                        let bNum = parseFloat(bVal.toString().replace(/[^0-9.,-]/g, '').replace(',', '.'));
                        if (!isNaN(aNum) && !isNaN(bNum)) {
                            return this.sortAsc ? aNum - bNum : bNum - aNum;
                        }
                        return this.sortAsc ? aVal.toString().localeCompare(bVal.toString()) : bVal.toString()
                            .localeCompare(aVal.toString());
                    });
                }
            };
        }
    </script>
@endpush
